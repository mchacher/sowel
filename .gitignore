node_modules
dist/
data/
.env
.env.*
*.db
*.db-wal
*.db-shm
.DS_Store

# Secrets and credentials (never commit these)
*.secret
*.key
*.pem
*.p12
*.pfx
credentials*.json
.netrc

# Sowel backups (contain plaintext integration secrets per audit F01)
*backup*.zip
*backup*.json
backup-*.tar*

# Local test scripts that may carry hardcoded credentials.
# Use scripts/private/ or similar for any test that needs real secrets.
scripts/*-test.py
scripts/test-*.py
scripts/private/

# Installed plugins (downloaded at runtime, not tracked)
plugins/*/
!plugins/registry.json
coverage/
.venv/

# MkDocs build output
site/

# Local tool configs
.claude/settings.json
.mcp.json
.playwright-mcp/

# TypeScript incremental build state
tsconfig.tsbuildinfo
ui/tsconfig.tsbuildinfo

# Local-only icon design scratchpad (not shipped)
assets/
# …but the MkDocs site assets do ship.
!docs/assets/
!docs/assets/**
