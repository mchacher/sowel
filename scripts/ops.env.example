# Template for the private ops companion repo (see docs/technical/contributing.md,
# section "Private ops companion repo", and CLAUDE.md section
# "Installation-specific context").
#
# Copy this file to ../sowel-ops/ops.env (a PRIVATE repo cloned next to this
# checkout) and fill in your own hosts. It is sourced by:
#   - scripts/run-swap.sh
#   - scripts/shadow-deploy.sh
#
# Shell syntax, no spaces around '='. Never commit real values to this repo.

# Production instance
SOWEL_PROD_SSH="user@your-prod-host"      # SSH target (key-based auth)
SOWEL_PROD_HOST="your-prod-host:3000"     # host:port of the Sowel API/UI

# Demo instance used for documentation screenshots (optional)
SOWEL_DEMO_SSH="user@your-demo-host"
SOWEL_DEMO_URL="http://your-demo-host:3001"
SOWEL_DEMO_COMPOSE_DIR="/home/user/sowel-demo"
