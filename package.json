{
  "name": "sowel",
  "version": "1.86.1",
  "description": "Sowel — Home automation engine powered by MQTT",
  "author": "Marc Chachereau <marc.chachereau@gmail.com>",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --exclude 'plugins/**' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,js}\" \"ui/src/**/*.{ts,tsx,css}\" \"ui/*.{ts,js,json}\" \"ui/eslint/**/*.js\" \"design-system/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,js}\" \"ui/src/**/*.{ts,tsx,css}\" \"ui/*.{ts,js,json}\" \"ui/eslint/**/*.js\" \"design-system/**/*.md\"",
    "validate": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run format:check && npm run test && npm run validate:ui",
    "validate:ui": "cd ui && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/websocket": "^11.3.7",
    "@influxdata/influxdb-client": "^1.35.0",
    "@types/archiver": "^8.0.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.16.1",
    "otplib": "^13.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "suncalc": "^2.1.3",
    "tz-lookup": "^6.1.25",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js}": [
      "prettier --write"
    ],
    "ui/src/**/*.{ts,tsx,css}": [
      "prettier --write"
    ],
    "ui/*.ts": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
